NODE_ENV=production
PORT=3000
FRONTEND_URL=https://app.tudominio.com
CORS_ORIGINS=https://app.tudominio.com

DATABASE_URL=postgresql://REEMPLAZAR_USUARIO:REEMPLAZAR_PASSWORD@REEMPLAZAR_HOST:5432/norbitex?schema=public
JWT_SECRET=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_DE_64_BYTES
JWT_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_MAX_AGE_MS=604800000

PAGINATION_DEFAULT_LIMIT=12
PAGINATION_MAX_LIMIT=100

TURNSTILE_SECRET_KEY=REEMPLAZAR

BREVO_ENABLED=true
BREVO_API_KEY=REEMPLAZAR
BREVO_SENDER_EMAIL=no-reply@tudominio.com
BREVO_SENDER_NAME=Norbitex
BREVO_REPLY_TO_EMAIL=soporte@tudominio.com

CLOUDFLARE_R2_ACCOUNT_ID=REEMPLAZAR
CLOUDFLARE_R2_ACCESS_KEY_ID=REEMPLAZAR
CLOUDFLARE_R2_SECRET_ACCESS_KEY=REEMPLAZAR
CLOUDFLARE_R2_PUBLIC_BUCKET=norbitex-public
CLOUDFLARE_R2_PRIVATE_BUCKET=norbitex-private
CLOUDFLARE_R2_LEGACY_BUCKET=norbitex
CLOUDFLARE_R2_PUBLIC_URL=https://archivos.tudominio.com
CLOUDFLARE_R2_PREFIX=products
CLOUDFLARE_R2_SIGNED_URL_TTL_SECONDS=300

LOCAL_STORAGE_DIR=/var/lib/norbitex/storage
SUNAT_SECRETS_ENCRYPTION_KEY=REEMPLAZAR_CON_32_BYTES_EN_BASE64
SUNAT_GUIA_REMISION_MODE=REAL
SUNAT_JOB_MAX_RETRIES=10
SUNAT_JOB_BATCH_SIZE=10
SUNAT_JOB_LOCK_MINUTES=10
SUNAT_CONSULTA_BASE_URL=https://api.apis.net.pe/v2

PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
