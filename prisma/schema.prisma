model Empresa {
  id                              BigInt                           @id @default(autoincrement())
  nombreComercial                 String                           @map("nombre_comercial") @db.VarChar(150)
  razonSocial                     String?                          @map("razon_social") @db.VarChar(200)
  ruc                             String?                          @unique @db.VarChar(20)
  dni                             String?                          @unique @db.VarChar(8)
  telefono                        String?                          @db.VarChar(30)
  email                           String?                          @db.VarChar(150)
  direccion                       String?
  comoConocio                     CanalConocimiento?               @map("como_conocio")
  comoConocioOtro                 String?                          @map("como_conocio_otro") @db.VarChar(100)
  estado                          EmpresaEstado                    @default(activa)
  planCodigo                      PlanCodigo                       @default(prueba) @map("plan_codigo")
  planInicioAt                    DateTime                         @default(now()) @map("plan_inicio_at") @db.Timestamptz(6)
  planFinAt                       DateTime?                        @map("plan_fin_at") @db.Timestamptz(6)
  logoUrl                         String?                          @map("logo_url") @db.VarChar(500)
  logoPdfUrl                      String?                          @map("logo_pdf_url") @db.VarChar(500)
  createdAt                       DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                       DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(6)
  usuarios                        EmpresaUsuario[]
  refreshTokens                   RefreshToken[]
  colores                         Color[]
  tallas                          Talla[]
  marcas                          Marca[]
  categorias                      Categoria[]
  sucursales                      Sucursal[]
  clientes                        Cliente[]
  productos                       Producto[]
  productoColores                 ProductoColor[]
  productoVariantes               ProductoVariante[]
  inventariosSucursal             InventarioSucursal[]
  stockMovimientos                StockMovimiento[]
  stockTraspasos                  StockTraspaso[]
  productoColorImagenes           ProductoColorImagen[]
  metodosPago                     MetodoPago[]
  ventas                          Venta[]
  notasCredito                    NotaCredito[]
  guiasRemision                   GuiaRemision[]
  catalogoTransporteParticipantes CatalogoTransporteParticipante[]
  catalogoVehiculos               CatalogoVehiculo[]
  cajasSesion                     CajaSesion[]
  cajaMovimientos                 CajaMovimiento[]
  cotizaciones                    Cotizacion[]
  seriesComprobante               SerieComprobante[]
  serieComprobanteSucursales      SerieComprobanteSucursal[]
  sunatConfig                     SunatConfig?
  sunatJobs                       SunatJob[]
  sunatBajaLotes                  SunatBajaLote[]
  platformAuditLogs               PlatformAuditLog[]
  pagosSuscripcion                PagoSuscripcion[]
  limitesAdicionales              EmpresaLimiteAdicional?
  liquidacionesExcedente          LiquidacionExcedente[]
  comprobantesPlataforma          ComprobantePlataforma[]
  cobrosAdicionalesPlataforma     CobroAdicionalPlataforma[]
  notificaciones                  Notificacion[]
  consultasDocumento              ConsultaDocumento[]
  afiliacion                      EmpresaAfiliacion?
  comisionesAfiliado              ComisionAfiliado[]

  @@map("empresa")
}

model SunatConfig {
  id                           BigInt        @id @default(autoincrement())
  empresaId                    BigInt        @unique @map("empresa_id")
  ambiente                     SunatAmbiente @default(BETA)
  usuarioSolEncrypted          String?       @map("usuario_sol_encrypted")
  claveSolEncrypted            String?       @map("clave_sol_encrypted")
  clientIdEncrypted            String?       @map("client_id_encrypted")
  clientSecretEncrypted        String?       @map("client_secret_encrypted")
  certificadoPasswordEncrypted String?       @map("certificado_password_encrypted")
  certificadoR2Key             String?       @map("certificado_r2_key") @db.VarChar(600)
  certificadoNombre            String?       @map("certificado_nombre") @db.VarChar(180)
  certificadoMimeType          String?       @map("certificado_mime_type") @db.VarChar(80)
  certificadoSizeBytes         Int?          @map("certificado_size_bytes")
  certificadoUploadedAt        DateTime?     @map("certificado_uploaded_at") @db.Timestamptz(6)
  igvPorcentaje                Decimal       @default(18.00) @map("igv_porcentaje") @db.Decimal(5, 2)
  activo                       Boolean       @default(false)
  createdAt                    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  empresa                      Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@index([activo])
  @@map("sunat_config")
}

model SunatEndpointConfig {
  id        BigInt              @id @default(autoincrement())
  ambiente  SunatAmbiente
  codigo    SunatEndpointCodigo
  url       String              @db.VarChar(255)
  activo    Boolean             @default(true)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([ambiente, codigo])
  @@index([ambiente])
  @@index([activo])
  @@map("sunat_endpoint_config")
}

model SunatJob {
  id            BigInt                @id @default(autoincrement())
  empresaId     BigInt                @map("empresa_id")
  tipoDocumento SunatJobTipoDocumento @map("tipo_documento")
  documentoId   BigInt                @map("documento_id")
  estado        SunatJobEstado        @default(pendiente_envio)
  intentos      Int                   @default(0)
  maxIntentos   Int                   @default(10) @map("max_intentos")
  ultimoError   String?               @map("ultimo_error") @db.VarChar(1000)
  ultimoCodigo  String?               @map("ultimo_codigo") @db.VarChar(40)
  nextRetryAt   DateTime?             @map("next_retry_at") @db.Timestamptz(6)
  lockedAt      DateTime?             @map("locked_at") @db.Timestamptz(6)
  lastAttemptAt DateTime?             @map("last_attempt_at") @db.Timestamptz(6)
  processedAt   DateTime?             @map("processed_at") @db.Timestamptz(6)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  empresa       Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([tipoDocumento, documentoId])
  @@index([empresaId])
  @@index([estado, nextRetryAt])
  @@index([lockedAt])
  @@map("sunat_job")
}

model SunatBajaLote {
  id                BigInt          @id @default(autoincrement())
  empresaId         BigInt          @map("empresa_id")
  tipoEnvio         SunatBajaTipo   @map("tipo_envio")
  fechaDocumento    DateTime        @map("fecha_documento") @db.Date
  fechaGeneracion   DateTime        @map("fecha_generacion") @db.Date
  correlativo       Int
  estado            SunatBajaEstado @default(pendiente_envio)
  codigo            String?         @db.VarChar(20)
  mensaje           String?         @db.VarChar(500)
  ticketSunat       String?         @map("ticket_sunat") @db.VarChar(120)
  sunatHash         String?         @map("sunat_hash") @db.VarChar(120)
  sunatXmlNombre    String?         @map("sunat_xml_nombre") @db.VarChar(180)
  sunatXmlKey       String?         @map("sunat_xml_key") @db.VarChar(600)
  sunatZipNombre    String?         @map("sunat_zip_nombre") @db.VarChar(180)
  sunatZipKey       String?         @map("sunat_zip_key") @db.VarChar(600)
  sunatCdrNombre    String?         @map("sunat_cdr_nombre") @db.VarChar(180)
  sunatCdrKey       String?         @map("sunat_cdr_key") @db.VarChar(600)
  sunatEnviadoAt    DateTime?       @map("sunat_enviado_at") @db.Timestamptz(6)
  sunatRespondidoAt DateTime?       @map("sunat_respondido_at") @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  empresa           Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  items             SunatBajaItem[]
  ventas            Venta[]

  @@unique([empresaId, tipoEnvio, fechaGeneracion, correlativo])
  @@index([empresaId])
  @@index([estado])
  @@index([tipoEnvio, fechaDocumento, fechaGeneracion])
  @@map("sunat_baja_lote")
}

model SunatBajaItem {
  id              BigInt               @id @default(autoincrement())
  loteId          BigInt               @map("lote_id")
  ventaId         BigInt               @map("venta_id")
  tipoComprobante VentaTipoComprobante @map("tipo_comprobante")
  serie           String               @db.VarChar(4)
  numero          Int
  fechaDocumento  DateTime             @map("fecha_documento") @db.Date
  motivo          String               @db.VarChar(255)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  lote            SunatBajaLote        @relation(fields: [loteId], references: [id], onDelete: Cascade)
  venta           Venta                @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  @@unique([ventaId])
  @@index([loteId])
  @@index([fechaDocumento])
  @@map("sunat_baja_item")
}

model Cliente {
  id              BigInt               @id @default(autoincrement())
  empresaId       BigInt               @map("empresa_id")
  tipoDocumento   ClienteTipoDocumento @map("tipo_documento")
  numeroDocumento String?              @map("numero_documento") @db.VarChar(20)
  nombre          String?              @db.VarChar(150)
  razonSocial     String?              @map("razon_social") @db.VarChar(200)
  telefono        String?              @db.VarChar(30)
  email           String?              @db.VarChar(150)
  direccion       String?              @db.VarChar(255)
  ubigeo          String?              @db.VarChar(6)
  distrito        String?              @db.VarChar(80)
  estado          ClienteEstado        @default(activo)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  empresa         Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  ventas          Venta[]
  notasCredito    NotaCredito[]
  cotizaciones    Cotizacion[]

  @@index([empresaId])
  @@index([tipoDocumento])
  @@index([numeroDocumento])
  @@index([estado])
  @@index([empresaId, estado])
  @@index([empresaId, createdAt])
  @@map("cliente")
}

model Sucursal {
  id                         BigInt                     @id @default(autoincrement())
  empresaId                  BigInt                     @map("empresa_id")
  nombre                     String                     @db.VarChar(120)
  nombreKey                  String                     @map("nombre_key") @db.VarChar(140)
  tipo                       SucursalTipo
  ubigeo                     String                     @db.VarChar(6)
  distrito                   String                     @db.VarChar(80)
  direccion                  String                     @db.VarChar(255)
  codigoEstablecimientoSunat String?                    @map("codigo_establecimiento_sunat") @db.VarChar(10)
  estado                     SucursalEstado             @default(activo)
  esPrincipal                Boolean                    @default(false) @map("es_principal")
  modoCajaHabilitado         Boolean                    @default(false) @map("modo_caja_habilitado")
  createdAt                  DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  empresa                    Empresa                    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  inventarios                InventarioSucursal[]
  stockMovimientos           StockMovimiento[]
  stockTraspasosOrigen       StockTraspaso[]            @relation("StockTraspasoOrigen")
  stockTraspasosDestino      StockTraspaso[]            @relation("StockTraspasoDestino")
  ventas                     Venta[]
  notasCredito               NotaCredito[]
  guiasRemision              GuiaRemision[]             @relation("GuiaRemisionSucursal")
  guiasRemisionPartida       GuiaRemision[]             @relation("GuiaRemisionSucursalPartida")
  guiasRemisionLlegada       GuiaRemision[]             @relation("GuiaRemisionSucursalLlegada")
  cajasSesion                CajaSesion[]
  cotizaciones               Cotizacion[]
  serieComprobanteSucursales SerieComprobanteSucursal[]
  usuariosAsignados          EmpresaUsuario[]           @relation("EmpresaUsuarioSucursal")

  @@unique([empresaId, nombreKey])
  @@index([empresaId])
  @@index([tipo])
  @@index([ubigeo])
  @@index([estado])
  @@map("sucursal")
}

model Color {
  id              BigInt          @id @default(autoincrement())
  empresaId       BigInt          @map("empresa_id")
  nombre          String          @db.VarChar(80)
  nombreKey       String          @map("nombre_key") @db.VarChar(100)
  sistemaCodigo   String?         @map("sistema_codigo") @db.VarChar(40)
  hex             String          @db.VarChar(7)
  activo          Boolean         @default(true)
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  empresa         Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  productoColores ProductoColor[]

  @@unique([empresaId, nombreKey])
  @@unique([empresaId, sistemaCodigo])
  @@index([empresaId])
  @@index([deletedAt])
  @@map("color")
}

model Talla {
  id                BigInt             @id @default(autoincrement())
  empresaId         BigInt             @map("empresa_id")
  nombre            String             @db.VarChar(80)
  nombreKey         String             @map("nombre_key") @db.VarChar(100)
  sistemaCodigo     String?            @map("sistema_codigo") @db.VarChar(40)
  activo            Boolean            @default(true)
  deletedAt         DateTime?          @map("deleted_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  empresa           Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  productoVariantes ProductoVariante[]

  @@unique([empresaId, nombreKey])
  @@unique([empresaId, sistemaCodigo])
  @@index([empresaId])
  @@index([deletedAt])
  @@map("talla")
}

model Marca {
  id        BigInt     @id @default(autoincrement())
  empresaId BigInt     @map("empresa_id")
  nombre    String     @db.VarChar(120)
  nombreKey String     @map("nombre_key") @db.VarChar(140)
  activo    Boolean    @default(true)
  deletedAt DateTime?  @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  empresa   Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  productos Producto[]

  @@unique([empresaId, nombreKey])
  @@index([empresaId])
  @@index([deletedAt])
  @@map("marca")
}

model Categoria {
  id          BigInt     @id @default(autoincrement())
  empresaId   BigInt     @map("empresa_id")
  nombre      String     @db.VarChar(120)
  nombreKey   String     @map("nombre_key") @db.VarChar(140)
  descripcion String?    @db.VarChar(500)
  activo      Boolean    @default(true)
  deletedAt   DateTime?  @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  empresa     Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  productos   Producto[]

  @@unique([empresaId, nombreKey])
  @@index([empresaId])
  @@index([deletedAt])
  @@map("categoria")
}

model UnidadMedida {
  id          BigInt     @id @default(autoincrement())
  codigo      String     @unique @db.VarChar(10)
  descripcion String     @db.VarChar(120)
  activo      Boolean    @default(true)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  productos   Producto[]

  @@map("unidad_medida")
}

model TipoAfectacionIgv {
  id          BigInt     @id @default(autoincrement())
  codigo      String     @unique @db.VarChar(4)
  descripcion String     @db.VarChar(180)
  activo      Boolean    @default(true)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  productos   Producto[]

  @@map("tipo_afectacion_igv")
}

model Producto {
  id                  BigInt             @id @default(autoincrement())
  publicId            String             @unique @default(cuid()) @map("public_id") @db.VarChar(30)
  empresaId           BigInt             @map("empresa_id")
  marcaId             BigInt?            @map("marca_id")
  categoriaId         BigInt?            @map("categoria_id")
  unidadMedidaId      BigInt             @map("unidad_medida_id")
  tipoAfectacionIgvId BigInt             @map("tipo_afectacion_igv_id")
  nombre              String             @db.VarChar(180)
  tipo                ProductoTipo       @default(variantes)
  nombreKey           String             @map("nombre_key") @db.VarChar(220)
  descripcion         String?            @db.VarChar(1000)
  activo              Boolean            @default(true)
  deletedAt           DateTime?          @map("deleted_at") @db.Timestamptz(6)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  empresa             Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  marca               Marca?             @relation(fields: [marcaId], references: [id], onDelete: SetNull)
  categoria           Categoria?         @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  unidadMedida        UnidadMedida       @relation(fields: [unidadMedidaId], references: [id], onDelete: Restrict)
  tipoAfectacionIgv   TipoAfectacionIgv  @relation(fields: [tipoAfectacionIgvId], references: [id], onDelete: Restrict)
  colores             ProductoColor[]
  variantes           ProductoVariante[]

