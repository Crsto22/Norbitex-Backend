  sunatZipKey        String?              @map("sunat_zip_key") @db.VarChar(600)
  sunatCdrNombre     String?              @map("sunat_cdr_nombre") @db.VarChar(180)
  sunatCdrKey        String?              @map("sunat_cdr_key") @db.VarChar(600)
  sunatPdfNombre     String?              @map("sunat_pdf_nombre") @db.VarChar(180)
  sunatPdfKey        String?              @map("sunat_pdf_key") @db.VarChar(600)
  sunatEnviadoAt     DateTime?            @map("sunat_enviado_at") @db.Timestamptz(6)
  sunatRespondidoAt  DateTime?            @map("sunat_respondido_at") @db.Timestamptz(6)
  stockDevuelto      Boolean              @default(false) @map("stock_devuelto")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  empresa            Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  ventaReferencia    Venta                @relation(fields: [ventaReferenciaId], references: [id], onDelete: Restrict)
  sucursal           Sucursal?            @relation(fields: [sucursalId], references: [id], onDelete: SetNull)
  cliente            Cliente?             @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  serieComprobante   SerieComprobante     @relation(fields: [serieComprobanteId], references: [id], onDelete: Restrict)
  creadoPor          Usuario?             @relation(fields: [creadoPorId], references: [id], onDelete: SetNull)
  detalles           NotaCreditoDetalle[]

  @@unique([serieComprobanteId, numero])
  @@index([empresaId])
  @@index([ventaReferenciaId])
  @@index([empresaId, sunatEstado])
  @@index([clienteId])
  @@index([sucursalId])
  @@index([serie, numero])
  @@index([correlativo])
  @@index([createdAt])
  @@map("nota_credito")
}

model NotaCreditoDetalle {
  id                       BigInt           @id @default(autoincrement())
  notaCreditoId            BigInt           @map("nota_credito_id")
  ventaDetalleReferenciaId BigInt?          @map("venta_detalle_referencia_id")
  productoVarianteId       BigInt           @map("producto_variante_id")
  descripcion              String?          @db.VarChar(255)
  cantidad                 Int
  unidadMedidaCodigo       String           @default("NIU") @map("unidad_medida_codigo") @db.VarChar(10)
  tipoAfectacionIgvCodigo  String           @default("10") @map("tipo_afectacion_igv_codigo") @db.VarChar(4)
  precioUnitario           Decimal          @map("precio_unitario") @db.Decimal(12, 2)
  valorUnitario            Decimal          @default(0) @map("valor_unitario") @db.Decimal(12, 10)
  descuentoMonto           Decimal          @default(0) @map("descuento_monto") @db.Decimal(12, 2)
  valorVenta               Decimal          @default(0) @map("valor_venta") @db.Decimal(12, 2)
  igvMonto                 Decimal          @default(0) @map("igv_monto") @db.Decimal(12, 2)
  subtotal                 Decimal          @db.Decimal(12, 2)
  total                    Decimal          @db.Decimal(12, 2)
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  notaCredito              NotaCredito      @relation(fields: [notaCreditoId], references: [id], onDelete: Cascade)
  ventaDetalleReferencia   VentaDetalle?    @relation(fields: [ventaDetalleReferenciaId], references: [id], onDelete: SetNull)
  productoVariante         ProductoVariante @relation(fields: [productoVarianteId], references: [id], onDelete: Restrict)

  @@index([notaCreditoId])
  @@index([ventaDetalleReferenciaId])
  @@index([productoVarianteId])
  @@map("nota_credito_detalle")
}

model VentaPago {
  id              BigInt           @id @default(autoincrement())
  ventaId         BigInt           @map("venta_id")
  metodoPagoId    BigInt           @map("metodo_pago_id")
  monto           Decimal          @db.Decimal(12, 2)
  montoRecibido   Decimal?         @map("monto_recibido") @db.Decimal(12, 2)
  vuelto          Decimal          @default(0) @db.Decimal(12, 2)
  referencia      String?          @db.VarChar(200)
  estado          VentaPagoEstado  @default(activo)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  venta           Venta            @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  metodoPago      MetodoPago       @relation(fields: [metodoPagoId], references: [id], onDelete: Restrict)
  cajaMovimientos CajaMovimiento[]

  @@index([ventaId])
  @@index([metodoPagoId])
  @@map("venta_pago")
}

model CajaSesion {
  id                    BigInt           @id @default(autoincrement())
  publicId              String           @unique @default(cuid()) @map("public_id") @db.VarChar(30)
  empresaId             BigInt           @map("empresa_id")
  sucursalId            BigInt           @map("sucursal_id")
  usuarioId             BigInt           @map("usuario_id")
  estado                CajaSesionEstado @default(abierta)
  openedAt              DateTime         @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt              DateTime?        @map("closed_at") @db.Timestamptz(6)
  montoInicial          Decimal          @default(0) @map("monto_inicial") @db.Decimal(12, 2)
  montoEsperado         Decimal?         @map("monto_esperado") @db.Decimal(12, 2)
  montoDeclarado        Decimal?         @map("monto_declarado") @db.Decimal(12, 2)
  diferencia            Decimal?         @db.Decimal(12, 2)
  observacionesApertura String?          @map("observaciones_apertura") @db.VarChar(500)
  observacionesCierre   String?          @map("observaciones_cierre") @db.VarChar(500)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  empresa               Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  sucursal              Sucursal         @relation(fields: [sucursalId], references: [id], onDelete: Cascade)
  usuario               Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  ventas                Venta[]
  movimientos           CajaMovimiento[]

  @@index([empresaId])
  @@index([sucursalId])
  @@index([usuarioId])
  @@index([estado])
  @@index([openedAt])
  @@map("caja_sesion")
}

model CajaMovimiento {
  id           BigInt             @id @default(autoincrement())
  publicId     String             @unique @default(cuid()) @map("public_id") @db.VarChar(30)
  empresaId    BigInt             @map("empresa_id")
  cajaSesionId BigInt             @map("caja_sesion_id")
  ventaId      BigInt?            @map("venta_id")
  ventaPagoId  BigInt?            @map("venta_pago_id")
  metodoPagoId BigInt?            @map("metodo_pago_id")
  tipo         CajaMovimientoTipo
  monto        Decimal            @db.Decimal(12, 2)
  motivo       String?            @db.VarChar(500)
  referencia   String?            @db.VarChar(200)
  creadoPorId  BigInt?            @map("creado_por_id")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  empresa      Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  cajaSesion   CajaSesion         @relation(fields: [cajaSesionId], references: [id], onDelete: Cascade)
  venta        Venta?             @relation(fields: [ventaId], references: [id], onDelete: SetNull)
  ventaPago    VentaPago?         @relation(fields: [ventaPagoId], references: [id], onDelete: SetNull)
  metodoPago   MetodoPago?        @relation(fields: [metodoPagoId], references: [id], onDelete: Restrict)
  creadoPor    Usuario?           @relation(fields: [creadoPorId], references: [id], onDelete: SetNull)

  @@index([empresaId])
  @@index([cajaSesionId])
  @@index([ventaId])
  @@index([ventaPagoId])
  @@index([metodoPagoId])
  @@index([tipo])
  @@index([createdAt])
  @@map("caja_movimiento")
}

model Cotizacion {
  id                BigInt              @id @default(autoincrement())
  publicId          String              @unique @default(cuid()) @map("public_id") @db.VarChar(30)
  empresaId         BigInt              @map("empresa_id")
  sucursalId        BigInt?             @map("sucursal_id")
  clienteId         BigInt?             @map("cliente_id")
  serie             String              @db.VarChar(4)
  numero            Int
  correlativo       String              @db.VarChar(15)
  estado            CotizacionEstado    @default(borrador)
  descuentoTipo     VentaDescuentoTipo? @map("descuento_tipo")
  descuentoValor    Decimal?            @map("descuento_valor") @db.Decimal(10, 2)
  subtotal          Decimal             @db.Decimal(12, 2)
  descuentoMonto    Decimal             @default(0) @map("descuento_monto") @db.Decimal(12, 2)
  total             Decimal             @db.Decimal(12, 2)
  observaciones     String?             @db.VarChar(500)
  requestId         String?             @map("request_id") @db.Uuid
  validaHasta       DateTime?           @map("valida_hasta") @db.Timestamptz(6)
  convertidaVentaId BigInt?             @unique @map("convertida_venta_id")
  creadoPorId       BigInt?             @map("creado_por_id")
  anuladoAt         DateTime?           @map("anulado_at") @db.Timestamptz(6)
  anuladoRazon      String?             @map("anulado_razon") @db.VarChar(500)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  empresa           Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  sucursal          Sucursal?           @relation(fields: [sucursalId], references: [id], onDelete: Cascade)
  cliente           Cliente?            @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  convertidaVenta   Venta?              @relation("CotizacionConvertidaVenta", fields: [convertidaVentaId], references: [id], onDelete: SetNull)
  creadoPor         Usuario?            @relation(fields: [creadoPorId], references: [id], onDelete: SetNull)
  detalles          CotizacionDetalle[]

  @@unique([empresaId, serie, numero])
  @@unique([empresaId, requestId])
  @@index([empresaId])
  @@index([empresaId, estado])
  @@index([sucursalId])
  @@index([clienteId])
  @@index([serie, numero])
  @@index([correlativo])
  @@index([createdAt])
  @@index([validaHasta])
  @@map("cotizacion")
}

model CotizacionDetalle {
  id                 BigInt              @id @default(autoincrement())
  cotizacionId       BigInt              @map("cotizacion_id")
  productoVarianteId BigInt              @map("producto_variante_id")
  cantidad           Int
  precioUnitario     Decimal             @map("precio_unitario") @db.Decimal(12, 2)
  descuentoTipo      VentaDescuentoTipo? @map("descuento_tipo")
  descuentoValor     Decimal?            @map("descuento_valor") @db.Decimal(10, 2)
  descuentoMonto     Decimal             @default(0) @map("descuento_monto") @db.Decimal(12, 2)
  subtotal           Decimal             @db.Decimal(12, 2)
  total              Decimal             @db.Decimal(12, 2)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  cotizacion         Cotizacion          @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  productoVariante   ProductoVariante    @relation(fields: [productoVarianteId], references: [id], onDelete: Restrict)

  @@index([cotizacionId])
  @@index([productoVarianteId])
  @@map("cotizacion_detalle")
}
